{
  "author": "Jason Williscroft",
  "bin": {
    "jeeves": "./dist/cli/jeeves/index.js"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves/issues"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonpath-plus": "^11.2.2",
    "package-directory": "^8.2.0",
    "semver": "^7.8.5",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "description": "Shared library and CLI for the Jeeves AI assistant platform.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fs-extra": "^11.4.1",
    "git-cliff": "^2.14.2",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js",
      "default": "./dist/openapi/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.js",
      "default": "./dist/fastify/index.js"
    }
  },
  "files": [
    "dist",
    "content",
    "skills",
    "skills-self-hosted"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves#readme",
  "keywords": [
    "jeeves",
    "ai",
    "assistant",
    "platform",
    "tools",
    "typescript"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "@karmaniverous/jeeves",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag ${version} --unreleased --strip header"
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run test",
        "npm run knip"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npm run build",
        "npx git-cliff --tag ${version} -o CHANGELOG.md",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves.git"
  },
  "scripts": {
    "build": "rimraf dist && cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin ./rollup-config-plugin.mjs",
    "changelog": "git-cliff -o CHANGELOG.md",
    "check:packed": "npm run build && tsx scripts/check-packed-consumer.ts",
    "generate:type-compat": "tsx scripts/generate-type-compat.ts",
    "diagrams": "cd diagrams/src && plantuml -tpng -o ../out -r .",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.8.0",
  "allowScripts": {
    "lefthook": true
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "release-it": {
      "undici": "7.30.1"
    }
  }
}
